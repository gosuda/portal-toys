# Simple Chat Configuration
# Copy this file to .env and fill in your values

# Admin UIDs (comma-separated)
# Get your UID by running /myuid command in the chat
CHAT_ADMIN_UIDS=your-uid-here,another-admin-uid

# Relay servers (comma-separated)
RELAY=wss://portal.gosuda.org/relay,wss://portal.hjjoon.com/relay

# Chat display name
CHAT_NAME=심플챗

# Chat description
CHAT_DESCRIPTION=포탈의 심플챗

# Hide from portal listings (true/false)
CHAT_HIDE=false

# Chat owner name
CHAT_OWNER=손희성

# Comma-separated tags
CHAT_TAGS=chat,simple,손희성

# Optional: Data path for persistent storage
CHAT_DATA_PATH=./chat-data

# Optional: Credential key (base64 encoded)
# CHAT_CRED_KEY=your-base64-encoded-key
